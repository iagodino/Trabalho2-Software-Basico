{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: gcc build mymemory + main",
            "command": "gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-Wall",
                "-Wextra",
                "-g",
                "${workspaceFolder}/mymemory.c",
                "${workspaceFolder}/main.c",
                "-o",
                "${workspaceFolder}/trabalho"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compila a biblioteca e o programa de teste com -Wall -Wextra"
        }
    ],
    "version": "2.0.0"
}
